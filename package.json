{
  "name": "swing-app",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo prebuild --platform android --no-clean --no-install && expo run:android",
    "ios": "expo prebuild --platform ios --no-clean --no-install && expo run:ios",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "verify": "npm run typecheck && npm run export:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/ionicons": "^13.1.5",
    "@react-native-vector-icons/material-design-icons": "^13.1.5",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/elements": "^2.9.25",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-maps-directions": "^1.9.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
